@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject Microsoft.AspNetCore.Components.Platform.IBrowserPlatform Browser
@inject NavigationManager Navigation

<h2>Cookie Store</h2>

<label for="cookie-name">Name</label>
<input id="cookie-name" @bind="name" />
<label for="cookie-value">Value</label>
<input id="cookie-value" @bind="value" />

<div>
    <button id="set-cookie" @onclick="SetAsync">Set</button>
    <button id="set-cookie-with-defaults" @onclick="SetWithDefaultsAsync">Set with defaults</button>
    <button id="set-cookie-with-options" @onclick="SetWithOptionsAsync">Set with options</button>
    <button id="set-cookie-with-max-age" @onclick="SetWithMaxAgeAsync">Set with max age</button>
    <button id="set-cookie-with-other-domain" @onclick="SetWithOtherDomainAsync">Set with another domain</button>
</div>
<div>
    <button id="get-cookie" @onclick="GetAsync">Get</button>
    <button id="get-cookie-with-options" @onclick="GetWithOptionsAsync">Get with options</button>
    <button id="get-all-cookies" @onclick="GetAllAsync">Get all</button>
    <button id="get-all-cookies-with-name" @onclick="GetAllWithNameAsync">Get all with name</button>
    <button id="get-all-cookies-with-options" @onclick="GetAllWithOptionsAsync">Get all with options</button>
</div>
<div>
    <button id="delete-cookie" @onclick="DeleteAsync">Delete</button>
    <button id="delete-cookie-with-options" @onclick="DeleteWithOptionsAsync">Delete with options</button>
</div>
<div>
    <button id="watch-cookie-changes" @onclick="WatchChangesAsync">Watch changes</button>
    <button id="watch-cookie-changes-second" @onclick="WatchChangesWithSecondListenerAsync">Watch changes with a second listener</button>
    <button id="unwatch-cookie-changes" @onclick="UnwatchChangesAsync">Stop watching changes</button>
</div>
<p id="cookie-result" role="status">@result</p>
<p id="cookie-change" role="status">@change</p>
<p id="cookie-change-second" role="status">@secondChange</p>

@code {
    // A path other than the page path shows that the Path member reaches the browser.
    private const string OptionsPath = "/cookie-path";

    private string name = "cookie";
    private string value = "initial";
    private string result = "No operation has run.";
    private string change = "No change has been reported.";
    private string secondChange = "No change has been reported.";
    private IAsyncDisposable? listener;
    private IAsyncDisposable? secondListener;

    private async Task SetAsync()
    {
        await Browser.Window.CookieStore.SetAsync(name, value);
        result = $"Set: {name}";
    }

    private async Task SetWithDefaultsAsync()
    {
        await Browser.Window.CookieStore.SetAsync(new CookieInit { Name = name, Value = value });
        result = $"Set with defaults: {name}";
    }

    private async Task SetWithOptionsAsync()
    {
        await Browser.Window.CookieStore.SetAsync(new CookieInit
        {
            Name = name,
            Value = value,
            Expires = DateTimeOffset.UtcNow.AddDays(1).ToUnixTimeMilliseconds(),
            Path = OptionsPath,
            SameSite = CookieSameSite.Lax,
        });
        result = $"Set with options: {name}";
    }

    private async Task SetWithMaxAgeAsync()
    {
        await Browser.Window.CookieStore.SetAsync(new CookieInit
        {
            Name = name,
            Value = value,
            MaxAge = 3600,
            SameSite = CookieSameSite.None,
        });
        result = $"Set with max age: {name}";
    }

    private async Task SetWithOtherDomainAsync()
    {
        // The browser rejects a domain that does not match the page, so the error shows that Domain reaches it.
        try
        {
            await Browser.Window.CookieStore.SetAsync(new CookieInit { Name = name, Value = value, Domain = "example.com" });
            result = $"Set with another domain: {name}";
        }
        catch (JSException)
        {
            result = "Another domain was rejected.";
        }
    }

    private async Task GetAsync()
    {
        try
        {
            result = Format(await Browser.Window.CookieStore.GetAsync(name));
        }
        catch (NotSupportedException ex)
        {
            result = $"Not supported: {ex.InnerException?.GetType().Name}";
        }
    }

    private async Task GetWithOptionsAsync()
    {
        result = Format(await Browser.Window.CookieStore.GetAsync(new CookieStoreGetOptions { Name = name }));
    }

    private async Task GetAllAsync()
    {
        result = Format(await Browser.Window.CookieStore.GetAllAsync());
    }

    private async Task GetAllWithNameAsync()
    {
        result = Format(await Browser.Window.CookieStore.GetAllAsync(name));
    }

    private async Task GetAllWithOptionsAsync()
    {
        // The browser accepts only the URL of the current page.
        result = Format(await Browser.Window.CookieStore.GetAllAsync(new CookieStoreGetOptions { Name = name, Url = Navigation.Uri }));
    }

    private async Task DeleteAsync()
    {
        await Browser.Window.CookieStore.DeleteAsync(name);
        result = $"Deleted: {name}";
    }

    private async Task DeleteWithOptionsAsync()
    {
        await Browser.Window.CookieStore.DeleteAsync(new CookieStoreDeleteOptions { Name = name, Path = OptionsPath });
        result = $"Deleted with options: {name}";
    }

    private async Task WatchChangesAsync()
    {
        listener = await Browser.Window.CookieStore.AddEventListenerAsync(CookieStore.ChangeEvent, OnCookieChangeAsync);
        result = "Watching changes.";
    }

    private async Task WatchChangesWithSecondListenerAsync()
    {
        secondListener = await Browser.Window.CookieStore.AddEventListenerAsync(CookieStore.ChangeEvent, changeEvent =>
        {
            secondChange = Describe(changeEvent);
            StateHasChanged();
            return Task.CompletedTask;
        });
        result = "Watching changes with a second listener.";
    }

    private async Task UnwatchChangesAsync()
    {
        if (listener is not null)
        {
            await listener.DisposeAsync();
        }

        result = "Stopped watching changes.";
    }

    // The listener runs on the renderer's dispatcher, so StateHasChanged needs no InvokeAsync.
    private Task OnCookieChangeAsync(CookieChangeEvent changeEvent)
    {
        change = Describe(changeEvent);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static string Describe(CookieChangeEvent changeEvent)
        => string.Join(
            "; ",
            [
                .. changeEvent.Changed.Select(cookie => $"Changed: {cookie.Name}={cookie.Value}"),
                .. changeEvent.Deleted.Select(cookie => $"Deleted: {cookie.Name}"),
            ]);

    public async ValueTask DisposeAsync()
    {
        if (listener is not null)
        {
            await listener.DisposeAsync();
        }

        if (secondListener is not null)
        {
            await secondListener.DisposeAsync();
        }
    }

    private static string Format(CookieListItem? cookie)
        => cookie is null ? "Cookie is missing." : $"Found: {cookie.Name}={cookie.Value}";

    private static string Format(IReadOnlyList<CookieListItem> cookies)
        => cookies.Count == 0 ? "No cookies." : $"Found: {string.Join("; ", cookies.Select(cookie => $"{cookie.Name}={cookie.Value}"))}";
}
